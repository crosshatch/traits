{
  "name": "crosshatch",
  "type": "module",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./api": "./src/api/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./api": "./dist/api/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    }
  },
  "scripts": {
    "prepack": "tsc -b tsconfig.release.json --force"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "effect": "catalog:"
  }
}
