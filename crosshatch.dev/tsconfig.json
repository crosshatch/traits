{
  "extends": "../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "alchemy.run.ts",
    "drizzle.config.ts",
    "vite.config.ts",
    "test/**/*.ts",
    "test/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", ".alchemy"],
  "references": [{ "path": "../crosshatch" }],
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node", "@cloudflare/workers-types"],
    "noEmit": true
  }
}
