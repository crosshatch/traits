{
  "extends": "../tsconfig.base.json",
  "include": [".astro/types.d.ts", "src/**/*.ts", "src/**/*.tsx", "astro.config.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "astro/client"],
    "noEmit": true
  }
}
