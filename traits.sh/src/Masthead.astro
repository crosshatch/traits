---
import { pipe, String } from "effect"

import { ThemeToggle } from "./ThemeToggle.tsx"

const sections = [{ label: "Catalog", href: "/traits/" }]
const { pathname } = Astro.url
---

<header class="masthead">
  <a class="brand" href="/" aria-label="Traits home">
    <img class="emblem" src="/traits-mark.svg" width="48" height="48" alt="" />
    <span>TRAITS</span>
  </a>
  <nav class="masthead-sections" aria-label="Sections">
    {
      sections.map((section) => (
        <a
          href={section.href}
          aria-current={
            section.href === pathname ? "page" : pipe(pathname, String.startsWith(section.href)) ? "true" : undefined
          }
        >
          {section.label}
        </a>
      ))
    }
  </nav>
  <nav aria-label="Site">
    <a
      class="source-link"
      href="https://github.com/crosshatch/traits"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Source on GitHub (opens in a new tab)"
    >
      Source <span aria-hidden="true">↗</span>
    </a>
    <ThemeToggle client:load />
    <a
      class="social-link"
      href="https://x.com/CrosshatchDev"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Crosshatch Labs on X (opens in a new tab)"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.4l7.2-8.3L1.8 2h6.5l4.5 6.8Zm-1.1 18h1.7L7.4 3.9H5.6Z"
        ></path>
      </svg>
      <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
