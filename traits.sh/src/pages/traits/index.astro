---
import "../../catalog.css"

import { getCollection, render } from "astro:content"
import { Array } from "effect"

import * as Catalog from "../../Catalog.ts"
import ChapterHeading from "../../ChapterHeading.astro"
import Docs from "../../layouts/Docs.astro"
import Prose from "../../Prose.astro"
import TraitEntry from "../../TraitEntry.astro"

const traits = await getCollection("traits")
const sources = await Promise.all(
  Array.map(Catalog.sources(traits), async (source) => ({
    repository: source.repository,
    entries: await Promise.all(
      Array.map(source.entries, async (entry) => ({ entry, Content: (await render(entry)).Content }))
    )
  }))
)
---

<Docs
  title="Catalog — Traits"
  description="Browse the coding preferences agents have learned and stored as traits, with when each one applies and how to skip it."
  section="Catalog"
  band="rubric"
  navigation={Catalog.navigation({ traits })}
>
  <div class="catalog">
    <header class="catalog-header">
      <ChapterHeading eyebrow="The catalog" accent="rubric" level={1}>Traits</ChapterHeading>
      <Prose lead>
        <p>
          Coding preferences learned from feedback, stored as Markdown in each repository's <code>.agents/traits</code> directory.
        </p>
      </Prose>
    </header>
    {
      sources.map((source) => (
        <section class="catalog-source" aria-labelledby={`source-${source.repository}`}>
          <div class="catalog-source-head">
            <h2 id={`source-${source.repository}`}>
              <a href={`https://github.com/${source.repository}`} target="_blank" rel="noopener noreferrer">
                {source.repository} <span aria-hidden="true">↗</span>
              </a>
            </h2>
            <span class="meta">{source.entries.length} traits</span>
          </div>
          <ul class="trait-list">
            {source.entries.map((item) => (
              <li>
                <TraitEntry entry={item.entry} href={Catalog.href(item.entry)}>
                  <item.Content />
                </TraitEntry>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Docs>
