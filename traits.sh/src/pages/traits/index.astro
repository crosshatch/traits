---
import "../../catalog.css"

import { getCollection } from "astro:content"

import * as Catalog from "../../Catalog.ts"
import ChapterHeading from "../../ChapterHeading.astro"
import Docs from "../../layouts/Docs.astro"
import Prose from "../../Prose.astro"
import { mimeLabel } from "../../mimeLabel.ts"

const traits = await getCollection("traits")
const sources = Catalog.sources(traits)
---

<Docs
  title="Catalog — Traits"
  description="Browse the coding preferences agents have learned and stored as traits, with when each one applies and how to skip it."
  section="Catalog"
  band="rubric"
  navigation={Catalog.navigation({ traits })}
>
  <div class="catalog">
    <header class="catalog-header">
      <ChapterHeading eyebrow="The catalog" accent="rubric" level={1}>Traits</ChapterHeading>
      <Prose lead>
        <p>
          Coding preferences learned from feedback, stored as Markdown in each repository's <code>.agents/traits</code> directory.
        </p>
      </Prose>
    </header>
    {
      sources.map(([repository, entries]) => (
        <section class="catalog-source" aria-labelledby={`source-${repository}`}>
          <h2 id={`source-${repository}`}>
            <a href={`https://github.com/${repository}`} target="_blank" rel="noopener noreferrer">
              {repository}
            </a>
            <span class="catalog-count">{entries.length} traits</span>
          </h2>
          <ul class="trait-list">
            {entries.map((entry) => (
              <li>
                <a class="trait-name" href={Catalog.href(entry)}>
                  <code>{entry.data.name}</code>
                </a>
                {entry.data.when !== undefined && <p class="trait-when">When {entry.data.when}</p>}
                {entry.data.mime.length > 0 && (
                  <ul class="mime-chips" aria-label="File types">
                    {entry.data.mime.map((mime) => (
                      <li>{mimeLabel(mime)}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Docs>
