---
import "../../../../catalog.css"

import type { GetStaticPaths } from "astro"
import { getCollection, render } from "astro:content"

import * as Catalog from "../../../../Catalog.ts"
import { CodeSample } from "../../../../CodeSample.tsx"
import Docs from "../../../../layouts/Docs.astro"
import Prose from "../../../../Prose.astro"
import TraitEntry from "../../../../TraitEntry.astro"

export const getStaticPaths = (async () => {
  const traits = await getCollection("traits")
  return traits.map((entry) => ({
    params: { owner: entry.data.owner, repo: entry.data.repo, id: entry.data.traitId },
    props: { entry, traits }
  }))
}) satisfies GetStaticPaths

const { entry, traits } = Astro.props
const { name, when, traitId, owner, repo } = entry.data
const { Content } = await render(entry)
---

<Docs
  title={`${name} — Traits`}
  description={when === undefined ? `A trait from ${owner}/${repo}.` : `Applies when ${when}.`}
  section="Catalog"
  band="rubric"
  page="page"
  navigation={Catalog.navigation({ traits, current: entry })}
>
  <div class="catalog trait-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/traits/">Catalog</a>
      <span aria-hidden="true">/</span>
      <span class="meta">{owner}/{repo}</span>
    </nav>
    <TraitEntry {...{ entry }} headingLevel={1}>
      <Content />
    </TraitEntry>
    <Prose as="section">
      <h2>Skipping this trait</h2>
      <p>Add this comment before any code to skip the trait for a whole file. A reason is required.</p>
      <CodeSample client:visible title="File header" code={`// traits-ignore-file ${traitId}: <reason>`} />
    </Prose>
  </div>
</Docs>
