---
import "../docs.css"

import Masthead from "../Masthead.astro"
import type * as Catalog from "../Catalog.ts"
import SideNav from "../SideNav.astro"
import Page from "./Page.astro"

interface Props {
  readonly title: string
  readonly description: string
  /** The section's name, for its navigation. */
  readonly section: string
  /** The section's thumb-index pigment: Catalog is rubric. */
  readonly band: "rubric" | "lapis" | "gilt" | "verdigris"
  readonly navigation: ReadonlyArray<Catalog.NavigationGroup>
}

const { title, description, section, band, navigation } = Astro.props
---

<Page {...{ title, description }}>
  <a class="skip-link" href="#content">Skip to content</a>
  <Masthead />
  <div class={`docs margin-${band}`}>
    <button class="docs-contents quiet-button" type="button" popovertarget="docs-navigation">
      <span aria-hidden="true">◆</span> Contents
    </button>
    <SideNav id="docs-navigation" label={section} groups={navigation} />
    <main class="docs-content" id="content">
      <slot />
    </main>
  </div>
</Page>
