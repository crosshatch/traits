  "compliant": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Dispatch shipment board</title>\n  <style>\n    :root {\n      color-scheme: light dark;\n      font-family: system-ui, sans-serif;\n      background: light-dark(#f5f7fa, #121820);\n      color: light-dark(#17212e, #e2eaf4);\n    }\n    :root[data-theme=\"light\"] { color-scheme: light; }\n    :root[data-theme=\"dark\"] { color-scheme: dark; }\n    body { margin: 0 auto; max-width: 64rem; padding: 2rem; }\n    header { display: flex; align-items: center; justify-content: space-between; }\n    article {\n      margin-block: 1rem;\n      padding: 1.5rem;\n      border: 1px solid light-dark(#cad3df, #445164);\n      border-radius: 0.5rem;\n      background: light-dark(#ffffff, #202b39);\n    }\n    button { padding: 0.5rem 1rem; }\n  </style>\n  <script>\n    const savedTheme = localStorage.getItem(\"dispatch-theme\");\n    if (savedTheme) document.documentElement.dataset.theme = savedTheme;\n  </script>\n</head>\n<body>\n  <header>\n    <h1>Shipment board</h1>\n    <nav aria-label=\"Appearance\">\n      <button type=\"button\" data-appearance=\"light\">Light</button>\n      <button type=\"button\" data-appearance=\"dark\">Dark</button>\n    </nav>\n  </header>\n  <main>\n    <article><h2>Warehouse transfer</h2><p>Three pallets ready for collection.</p></article>\n    <article><h2>Regional delivery</h2><p>Driver expected at 14:30.</p></article>\n  </main>\n  <script>\n    document.querySelectorAll(\"[data-appearance]\").forEach((button) => {\n      button.addEventListener(\"click\", () => {\n        const theme = button.dataset.appearance;\n        document.documentElement.dataset.theme = theme;\n        localStorage.setItem(\"dispatch-theme\", theme);\n      });\n    });\n  </script>\n</body>\n</html>\n"
