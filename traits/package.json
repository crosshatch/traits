{
  "name": "traits",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "bin": {
    "traits": "./dist/main.js"
  },
  "files": [
    "*.ts",
    "!vite.config.ts",
    "_util/**/*.ts",
    "commands/**/*.ts",
    "skills/**/*.md",
    "toolkit/**/*.ts",
    "dist/package.json",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/vite.config.*"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./index.ts",
    "./*": "./*.ts",
    "./_util/*": null,
    "./index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./_util/*": null,
      "./index": null
    },
    "access": "public"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  }
}
