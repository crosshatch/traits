{
  "extends": "./tsconfig.base.json",
  "references": [{ "path": "./crosshatch" }],
  "include": [
    "vitest.config.ts",
    "crosshatch/test/**/*.ts",
    "crosshatch/test/**/*.json",
    "crosshatch/typetest/**/*.ts"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "crosshatch": ["./crosshatch/src/index.ts"],
      "crosshatch/*": ["./crosshatch/src/*.ts"]
    }
  }
}
