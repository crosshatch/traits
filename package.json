{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "build": "pnpm --filter crosshatch build",
    "check": "tsc -b tsconfig.json",
    "test": "pnpm test:library",
    "test:library": "vitest run",
    "test:types": "tstyche",
    "test:integration": "pnpm --filter crosshatch.dev test",
    "verify": "pnpm build && pnpm check && pnpm test && pnpm test:types",
    "verify:live": "pnpm verify && pnpm test:integration"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "tstyche": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
